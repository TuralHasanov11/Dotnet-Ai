{
    "version": "0.2.0",
    "configurations": [
        {
          "name": "Containers .NET Attach (Preview) - AgentFrameworkQuickStart",
          "type": "docker",
          "request": "attach",
          "platform": "netCore",
          "sourceFileMap": {
            "/src": "${workspaceFolder}"
          },
          "preLaunchTask": "compose: up with apps - AgentFrameworkQuickStart"
        },
        {
            "name": ".NET Core Launch AgentFrameworkQuickStart",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/AgentFrameworkQuickStart/bin/Debug/net10.0/AgentFrameworkQuickStart.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/AgentFrameworkQuickStart",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(http?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Launch WebApp1",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: WebApp1",
            "program": "${workspaceFolder}/src/WebApp1/bin/Debug/net10.0/WebApp1.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/WebApp1",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(http?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        
    ]
}